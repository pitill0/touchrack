#!/bin/sh
set -eu

if [ "$#" -ne 0 ]; then
    echo "usage: touchrack-container-inventory" >&2
    exit 64
fi

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_ALL=C

if command -v podman >/dev/null 2>&1; then
    engine=Podman
elif command -v docker >/dev/null 2>&1; then
    engine=Docker
else
    echo "Neither Podman nor Docker is installed or available in PATH" >&2
    exit 127
fi

printf 'touchrack_containers_protocol=1\n'
printf 'engine=%s\n' "$engine"
printf 'ps_begin\n'
if [ "$engine" = Podman ]; then
    podman ps --all --format json
else
    docker ps --all --no-trunc --format '{{json .}}'
fi
printf 'ps_end\n'

# Capture stderr separately so successful JSON is never polluted by
# warnings from Podman or Docker. Retain diagnostics on failed stats.
stats_stderr_file=$(mktemp "${TMPDIR:-/tmp}/touchrack-stats.XXXXXXXX")
trap 'rm -f "$stats_stderr_file"' 0

set +e
if [ "$engine" = Podman ]; then
    stats_output=$(podman stats --all --no-stream --format json 2>"$stats_stderr_file")
    stats_status=$?
else
    stats_output=$(docker stats --all --no-stream --format '{{json .}}' 2>"$stats_stderr_file")
    stats_status=$?
fi
set -e

if [ "$stats_status" -ne 0 ]; then
    if [ -s "$stats_stderr_file" ]; then
        stats_output=$(printf '%s\\n%s' "$stats_output" "$(cat "$stats_stderr_file")")
    fi
elif [ -s "$stats_stderr_file" ]; then
    cat "$stats_stderr_file" >&2
fi

printf 'stats_status=%s\n' "$stats_status"
printf 'stats_begin\n'
printf '%s\n' "$stats_output"
printf 'stats_end\n'
