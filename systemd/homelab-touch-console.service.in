[Unit]
Description=Homelab Touch Console
After=local-fs.target systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=simple

WorkingDirectory=@RUNTIME_DIR@

Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUTF8=1
Environment=TERM=linux
Environment=HOMELAB_CONFIG=@CONFIG_DIR@/config.yaml
Environment=HOMELAB_LOCK_FILE=/run/touchrack/homelab-touch-console.lock

ExecStartPre=-/bin/setfont -C /dev/tty1 /usr/share/consolefonts/Uni3-Terminus32x16.psf.gz

ExecStart=/usr/bin/openvt -c 1 -f -s -w -- @VENV_BIN@/homelab-console

ExecStopPost=-/bin/sh -c '/usr/bin/setterm --blank=0 </dev/tty1 >/dev/tty1 2>/dev/null'

Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

# Conservative sandboxing: keep direct hardware, Docker and network access,
# while blocking privilege escalation and kernel-management surfaces that
# TouchRack does not need.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_SYS_TTY_CONFIG CAP_MKNOD
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RuntimeDirectory=touchrack
RuntimeDirectoryMode=0750
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
