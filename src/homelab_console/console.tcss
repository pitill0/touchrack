/* Homelab Touch Console — cleaned TCSS for Textual
   Target: Linux TTY, 64x18 cells, touch-first.
   Reviewed against Textual TCSS documentation.
   No web-CSS-only pseudo-classes are used.
*/

/* ---------- Base ---------- */

Screen {
    layout: vertical;
    background: $surface;
}

#content {
    height: 1fr;
    padding: 0;
}

.section-view {
    width: 100%;
    height: 100%;
}

.hidden {
    display: none;
}

#touch-diagnostic {
    display: none;
}

/* ---------- Shared main-screen controls ---------- */

Screen.compact-touch .flat-control,
Screen.compact-touch .refresh-interval-button,
Screen.compact-touch .screen-blank-button {
    margin: 0;
    padding: 0;
    border: none;
    content-align: center middle;
    text-style: bold;
}

Screen.compact-touch #menu-button,
Screen.compact-touch #menu-button-services,
Screen.compact-touch #menu-button-storage,
Screen.compact-touch #menu-button-containers {
    width: 5;
    min-width: 5;
    height: 3;
    margin: 0 1 0 0;
    background: $primary;
    color: $text;
}

Screen.compact-touch #refresh-interval-host,
Screen.compact-touch #refresh-interval-services,
Screen.compact-touch #refresh-interval-storage,
Screen.compact-touch #refresh-interval-containers {
    width: 10;
    min-width: 10;
    height: 3;
    background: $surface-lighten-2;
}

Screen.compact-touch #screen-blank-host,
Screen.compact-touch #screen-blank-services,
Screen.compact-touch #screen-blank-storage,
Screen.compact-touch #screen-blank-containers {
    width: 12;
    min-width: 12;
    height: 3;
    margin-left: 1;
    background: $surface-lighten-2;
}

/* ---------- HOST ---------- */

Screen.compact-touch #host-command-bar {
    width: 100%;
    height: 3;
    padding: 0 1;
    background: $surface-lighten-1;
}

Screen.compact-touch #host-name {
    width: 1fr;
    min-width: 12;
    height: 3;
    content-align: left middle;
    text-style: bold;
    overflow: hidden;
}

Screen.compact-touch #host-health {
    width: 7;
    min-width: 7;
    height: 3;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

Screen.compact-touch #host-health.healthy { color: $success; }
Screen.compact-touch #host-health.degraded { color: $warning; }
Screen.compact-touch #host-health.unavailable { color: $error; }

Screen.compact-touch #resource-metrics {
    width: 100%;
    height: 10;
    padding: 0 1;
}

Screen.compact-touch .resource-metric-row {
    width: 100%;
    height: 3;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
}

Screen.compact-touch .resource-metric-main {
    width: 100%;
    height: 1;
}

Screen.compact-touch .resource-metric-title {
    width: 6;
    min-width: 6;
    height: 1;
    content-align: left middle;
    color: $text-muted;
    text-style: bold;
}

Screen.compact-touch .resource-metric-value {
    width: 7;
    min-width: 7;
    height: 1;
    padding-right: 1;
    content-align: right middle;
    text-align: right;
    text-style: bold;
}

Screen.compact-touch .inline-bar {
    width: 1fr;
    height: 1;
    content-align: left middle;
    color: $primary;
    text-style: bold;
    overflow: hidden;
}

Screen.compact-touch .inline-bar.low { color: $primary; }
Screen.compact-touch .inline-bar.medium { color: $warning; }
Screen.compact-touch .inline-bar.high { color: $error; }
Screen.compact-touch .inline-bar.unknown { color: $text-muted; }

Screen.compact-touch .resource-metric-detail {
    width: 100%;
    height: 1;
    padding-left: 13;
    color: $text-muted;
    overflow: hidden;
}

Screen.compact-touch #metric-temperature {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: $surface-lighten-1;
}

Screen.compact-touch .temperature-title {
    width: 6;
    height: 1;
    color: $text-muted;
    text-style: bold;
}

Screen.compact-touch #temperature-value {
    width: 7;
    height: 1;
    padding-right: 1;
    text-align: right;
    text-style: bold;
}

Screen.compact-touch #temperature-state {
    width: 12;
    height: 1;
    text-style: bold;
}

Screen.compact-touch #temperature-state.normal { color: $success; }
Screen.compact-touch #temperature-state.warm { color: $warning; }
Screen.compact-touch #temperature-state.hot { color: $error; }
Screen.compact-touch #temperature-state.unknown { color: $text-muted; }

Screen.compact-touch #host-uptime {
    width: 1fr;
    height: 1;
    color: $text-muted;
    text-align: right;
    text-style: bold;
    overflow: hidden;
}

Screen.compact-touch #host-uptime.has-error {
    color: $error;
}

/* ---------- SERVICES ---------- */

Screen.compact-touch #services-header {
    width: 100%;
    height: 3;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $surface-lighten-1;
}

Screen.compact-touch #services-title {
    width: 1fr;
    min-width: 12;
    height: 3;
    content-align: left middle;
    text-style: bold;
    overflow: hidden;
}

Screen.compact-touch #services-health {
    width: 7;
    min-width: 7;
    height: 3;
    margin: 0;
    padding: 0;
    background: transparent;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

Screen.compact-touch #services-health.healthy { color: $success; }
Screen.compact-touch #services-health.degraded { color: $warning; }
Screen.compact-touch #services-health.unavailable { color: $error; }

Screen.compact-touch #services-status {
    width: 100%;
    height: 1;
    margin: 0;
    padding: 0 1;
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    overflow: hidden;
}

Screen.compact-touch #services-status.has-warning { color: $warning; }
Screen.compact-touch #services-status.has-error { color: $error; }


Screen.compact-touch #services-grid {
    grid-size: 3 4;
    grid-gutter: 0 1;
    width: 100%;
    height: 8;
    margin: 0;
    padding: 0 1;
}

Screen.compact-touch .service-card {
    width: 1fr;
    height: 2;
    min-height: 2;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $surface-lighten-1;
    color: $text;
    content-align: left middle;
    text-align: left;
    overflow: hidden;
}

Screen.compact-touch .service-card.status-ok { color: $text; }
Screen.compact-touch .service-card.status-idle { color: $text; }
Screen.compact-touch .service-card.status-warn { color: $text; }
Screen.compact-touch .service-card.status-error { color: $text; }
Screen.compact-touch .service-card.status-unknown { color: $text; }

Screen.compact-touch .service-card.service-card-empty {
    visibility: hidden;
}

Screen.compact-touch .service-card:focus,
Screen.compact-touch .service-card:hover {
    background: $surface-lighten-2;
    text-style: bold;
}


Screen.compact-touch #services-pager {
    width: 100%;
    height: 2;
    margin: 0;
    padding: 0 16;
    background: transparent;
}

Screen.compact-touch #services-pager.pager-hidden {
    display: none;
}

Screen.compact-touch .services-page-button {
    width: 8;
    min-width: 8;
    height: 2;
    min-height: 2;
    margin: 0;
    padding: 0;
    border: none;
    background: $surface-lighten-1;
    color: $primary;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

Screen.compact-touch #services-page-indicator {
    width: 1fr;
    height: 2;
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}


/* ---------- STORAGE ---------- */

Screen.compact-touch #storage-header {
    width: 100%;
    height: 3;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $surface-lighten-1;
}

Screen.compact-touch #storage-title {
    width: 1fr;
    min-width: 12;
    height: 3;
    content-align: left middle;
    text-style: bold;
    overflow: hidden;
}

Screen.compact-touch #storage-health {
    width: 7;
    min-width: 7;
    height: 3;
    margin: 0;
    padding: 0;
    background: transparent;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

Screen.compact-touch #storage-health.healthy { color: $success; }
Screen.compact-touch #storage-health.degraded { color: $warning; }
Screen.compact-touch #storage-health.unavailable { color: $error; }

Screen.compact-touch #storage-mode-selector {
    width: 100%;
    height: 2;
    margin: 0;
    padding: 0 1;
}

Screen.compact-touch .storage-mode-spacer {
    width: 1fr;
    height: 2;
}

Screen.compact-touch .storage-mode-button {
    width: 11;
    min-width: 11;
    height: 2;
    min-height: 2;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

Screen.compact-touch .storage-mode-button.selected {
    color: $primary;
    text-style: bold;
}

Screen.compact-touch #storage-status {
    width: 1fr;
    height: 2;
    margin: 0;
    padding: 0;
    color: $text-muted;
    content-align: right middle;
    text-align: right;
    overflow: hidden;
}

Screen.compact-touch #storage-status.has-warning { color: $warning; }
Screen.compact-touch #storage-status.has-error { color: $error; }

Screen.compact-touch #storage-grid {
    grid-size: 1 4;
    grid-gutter: 0;
    width: 100%;
    height: 8;
    margin: 0;
    padding: 0 1;
}

Screen.compact-touch .storage-filesystem {
    width: 100%;
    height: 2;
    min-height: 2;
    margin: 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $text;
    content-align: left middle;
    text-align: left;
    overflow: hidden;
}

Screen.compact-touch .storage-filesystem.storage-filesystem-empty {
    visibility: hidden;
}

Screen.compact-touch .storage-filesystem:focus,
Screen.compact-touch .storage-filesystem:hover {
    background: $surface-lighten-1;
}

Screen.compact-touch #storage-disks-grid {
    grid-size: 1 4;
    grid-gutter: 0;
    width: 100%;
    height: 8;
    margin: 0;
    padding: 0 1;
}

Screen.compact-touch .storage-disk {
    width: 100%;
    height: 2;
    min-height: 2;
    margin: 0;
    padding: 0 2;
    border: none;
    background: transparent;
    color: $text;
    content-align: left middle;
    text-align: left;
    overflow: hidden;
}

Screen.compact-touch .storage-disk.storage-disk-empty {
    visibility: hidden;
}

Screen.compact-touch .storage-disk:focus,
Screen.compact-touch .storage-disk:hover {
    background: $surface-lighten-1;
}


Screen.compact-touch #storage-pager {
    width: 100%;
    height: 1;
    margin: 0;
    padding: 0 18;
    background: transparent;
}

Screen.compact-touch #storage-pager.pager-hidden {
    display: none;
}

Screen.compact-touch .storage-page-button {
    width: 7;
    min-width: 7;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $primary;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

Screen.compact-touch #storage-page-indicator {
    width: 1fr;
    height: 1;
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

/* ---------- CONTAINERS ---------- */

Screen.compact-touch #containers-header {
    width: 100%;
    height: 3;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $surface-lighten-1;
}

Screen.compact-touch #containers-title {
    width: 1fr;
    min-width: 12;
    height: 3;
    content-align: left middle;
    text-style: bold;
    overflow: hidden;
}

Screen.compact-touch #containers-health {
    width: 7;
    min-width: 7;
    height: 3;
    margin: 0;
    padding: 0;
    background: transparent;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

Screen.compact-touch #containers-health.healthy { color: $success; }
Screen.compact-touch #containers-health.degraded { color: $warning; }
Screen.compact-touch #containers-health.unavailable { color: $error; }

Screen.compact-touch #containers-context {
    display: none;
}

Screen.compact-touch #containers-view-button {
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $primary;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

Screen.compact-touch .btop-view-button {
    width: 6;
    min-width: 6;
    height: 3;
    min-height: 3;
}

Screen.compact-touch .compact-view-button {
    width: 6;
    min-width: 6;
    height: 2;
    min-height: 2;
}

Screen.compact-touch #containers-status {
    width: 1fr;
    height: 2;
    margin: 0;
    padding: 0;
    content-align: left middle;
    color: $text-muted;
    overflow: hidden;
}

Screen.compact-touch #containers-status.has-error { color: $error; }
Screen.compact-touch #containers-status.has-warning { color: $warning; }

Screen.compact-touch #containers-last-update {
    display: none;
}

Screen.compact-touch #containers-body {
    width: 100%;
    height: 9;
}

Screen.compact-touch .containers-summary,
Screen.compact-touch .btop-containers-summary {
    width: 100%;
    height: 100%;
}

Screen.compact-touch #btop-container-totals {
    width: 100%;
    height: 3;
    margin: 0;
}

Screen.compact-touch .btop-total {
    width: 1fr;
    height: 3;
    margin: 0;
    border: none;
    background: transparent;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

Screen.compact-touch .btop-total.running { color: $success; }
Screen.compact-touch .btop-total.stopped { color: $warning; }
Screen.compact-touch .btop-total.total { color: $primary; }

Screen.compact-touch #btop-container-rankings {
    grid-size: 2 1;
    grid-gutter: 0 2;
    width: 100%;
    height: 6;
}

Screen.compact-touch .btop-ranking {
    height: 6;
    padding: 0 1;
    border: none;
    background: $surface;
}

Screen.compact-touch .btop-ranking-title {
    width: 100%;
    height: 1;
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

Screen.compact-touch .resource-ranking-row {
    width: 100%;
    height: 1;
}

Screen.compact-touch .resource-ranking-name {
    width: 1fr;
    height: 1;
    overflow: hidden;
}

Screen.compact-touch .resource-ranking-bar {
    width: 8;
    padding-left: 1;
    height: 1;
    color: $primary;
    text-style: bold;
}

Screen.compact-touch .resource-ranking-value {
    width: 7;
    height: 1;
    content-align: right middle;
    text-align: right;
    text-style: bold;
}

Screen.compact-touch .summary-ranking-empty {
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

Screen.compact-touch .btop-stopped-panel {
    display: none;
}

/* Compact list mode */

Screen.compact-touch .containers-compact-list {
    width: 100%;
    height: 100%;
    scrollbar-size: 2 1;
}

Screen.compact-touch .compact-list-header {
    width: 100%;
    height: 2;
    padding: 0;
}

Screen.compact-touch .compact-header-button {
    height: 2;
    min-height: 2;
    margin: 0;
    padding: 0;
    border: none;
    background: $surface;
    color: $text-muted;
    text-style: bold;
    content-align: left middle;
    text-align: left;
}

Screen.compact-touch .compact-header-button:hover,
Screen.compact-touch .compact-header-button:focus {
    background: $surface-lighten-1;
    color: $text;
}

Screen.compact-touch .compact-header-button.name,
Screen.compact-touch .compact-cell.name {
    width: 1fr;
}

Screen.compact-touch .compact-header-button.state,
Screen.compact-touch .compact-cell.state {
    width: 9;
}

Screen.compact-touch .compact-header-button.metric,
Screen.compact-touch .compact-cell.metric {
    width: 8;
    content-align: right middle;
    text-align: right;
}

Screen.compact-touch .compact-container-row {
    width: 100%;
    height: 2;
    min-height: 2;
    margin: 0;
    padding: 0;
    border: none;
    border-left: thick $surface-lighten-2;
}

Screen.compact-touch .compact-container-row.running {
    border-left: thick $success;
}

Screen.compact-touch .compact-container-row.stopped {
    border-left: thick $warning;
    color: $text-muted;
}

Screen.compact-touch .compact-cell {
    height: 2;
    min-height: 2;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $text;
    content-align: left middle;
    text-align: left;
}

Screen.compact-touch .compact-cell:hover,
Screen.compact-touch .compact-cell:focus {
    background: $surface-lighten-1;
}

Screen.compact-touch .containers-empty {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

/* ---------- Bottom navigation ---------- */

Screen.compact-touch #navigation {
    width: 100%;
    height: 4;
    padding: 1 0 0 0;
    margin: 0;
    background: $background;
}

Screen.compact-touch .nav,
Screen.compact-touch .nav:focus {
    width: 1fr;
    height: 3;
    margin: 0;
    padding: 0;
    border: none;
    background: $surface-lighten-1;
    color: $text-muted;
    content-align: center middle;
    text-style: bold;
}

Screen.compact-touch .nav.active,
Screen.compact-touch .nav.active:focus {
    border: none;
    border-top: solid $primary;
    background: $primary;
    color: $text;
    text-style: bold;
}

/* ---------- Modal menu ---------- */

ConsoleMenu {
    align: center middle;
    background: $background 70%;
}

ConsoleMenu #menu-dialog {
    width: 54;
    height: 16;
    max-height: 16;
    padding: 0 1;
    border: round $primary;
    background: $surface;
}

ConsoleMenu #menu-title {
    width: 100%;
    height: 2;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

ConsoleMenu #menu-about {
    width: 100%;
    height: 2;
    margin: 0 0 1 0;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

ConsoleMenu #menu-dialog Button {
    width: 100%;
    height: 2;
    min-height: 2;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $surface;
    color: $text;
    content-align: center middle;
    text-style: bold;
}

ConsoleMenu #menu-dialog Button:focus,
ConsoleMenu #menu-dialog Button:hover {
    border: none;
    background: $surface-lighten-1;
    color: $text;
}

ConsoleMenu #menu-dialog Button.menu-danger {
    color: $error;
}

ConsoleMenu #menu-dialog Button.menu-danger:focus,
ConsoleMenu #menu-dialog Button.menu-danger:hover {
    color: $error;
}

/* ---------- Shared modal BACK control ---------- */

#container-detail-back,
#service-detail-back,
#storage-detail-back,
#disk-detail-back,
#diagnostics-back {
    width: 10;
    min-width: 10;
    height: 2;
    min-height: 2;
    margin: 0 1 0 0;
    padding: 0;
    border: none;
    background: $primary;
    color: white;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

#container-detail-back:focus,
#container-detail-back:hover,
#service-detail-back:focus,
#service-detail-back:hover,
#storage-detail-back:focus,
#storage-detail-back:hover,
#disk-detail-back:focus,
#disk-detail-back:hover,
#diagnostics-back:focus,
#diagnostics-back:hover {
    border: none;
    background: $primary-lighten-1;
    color: white;
}


/* ---------- Storage details ---------- */

StorageDetailScreen {
    align: center middle;
    background: $background 75%;
}

StorageDetailScreen #storage-detail-dialog {
    width: 62;
    height: 15;
    padding: 0 1;
    border: round $primary;
    background: $surface;
}

StorageDetailScreen #storage-detail-header {
    width: 100%;
    height: 2;
    margin: 0 0 1 0;
}

StorageDetailScreen #storage-detail-title {
    width: 1fr;
    height: 2;
    content-align: left middle;
    text-style: bold;
    overflow: hidden;
}

StorageDetailScreen #storage-detail-state {
    width: 9;
    min-width: 9;
    height: 2;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

StorageDetailScreen #storage-detail-state.normal { color: $success; }
StorageDetailScreen #storage-detail-state.warning { color: $warning; }
StorageDetailScreen #storage-detail-state.critical { color: $error; }

StorageDetailScreen .storage-detail-line {
    width: 100%;
    height: 1;
    color: $text;
    overflow: hidden;
}


/* ---------- Disk details ---------- */

DiskDetailScreen {
    align: center middle;
    background: $background 75%;
}

DiskDetailScreen #disk-detail-dialog {
    width: 62;
    height: 16;
    padding: 0 1;
    border: round $primary;
    background: $surface;
}

DiskDetailScreen #disk-detail-header {
    width: 100%;
    height: 2;
    margin: 0 0 1 0;
}

DiskDetailScreen #disk-detail-title {
    width: 1fr;
    height: 2;
    content-align: left middle;
    text-style: bold;
    overflow: hidden;
}

DiskDetailScreen #disk-detail-state {
    width: 9;
    min-width: 9;
    height: 2;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

DiskDetailScreen #disk-detail-state.normal { color: $success; }
DiskDetailScreen #disk-detail-state.critical { color: $error; }
DiskDetailScreen #disk-detail-state.unknown { color: $text-muted; }

DiskDetailScreen .disk-detail-line {
    width: 100%;
    height: 1;
    color: $text;
    overflow: hidden;
}

/* ---------- Container details ---------- */

ContainerDetailScreen {
    align: center middle;
    background: $background 75%;
}

ContainerDetailScreen #container-detail-dialog {
    width: 62;
    height: 17;
    padding: 0 1;
    border: round $primary;
    background: $surface;
}

ContainerDetailScreen #container-detail-header {
    width: 100%;
    height: 2;
    margin: 0 0 1 0;
}

ContainerDetailScreen #container-detail-title-block {
    width: 1fr;
    height: 2;
}

ContainerDetailScreen #container-detail-name {
    height: 1;
    text-style: bold;
}

ContainerDetailScreen #container-detail-engine {
    height: 1;
    color: $text-muted;
}

ContainerDetailScreen #container-detail-state {
    width: 16;
    height: 2;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

ContainerDetailScreen #container-detail-state.running { color: $success; }
ContainerDetailScreen #container-detail-state.stopped { color: $warning; }

ContainerDetailScreen #container-detail-grid {
    grid-size: 2 3;
    grid-gutter: 0 1;
    width: 100%;
    height: 1fr;
}

ContainerDetailScreen .container-detail-card {
    height: 4;
    padding: 0 1;
    border: round $surface-lighten-2;
    content-align: left middle;
}

ContainerDetailScreen .container-detail-card.wide {
    column-span: 2;
}

/* ---------- Service details ---------- */

ServiceDetailScreen {
    align: center middle;
    background: $background 75%;
}

ServiceDetailScreen #service-detail-dialog {
    width: 62;
    height: 17;
    padding: 0 1;
    border: round $primary;
    background: $surface;
}

ServiceDetailScreen #service-detail-header {
    width: 100%;
    height: 2;
    margin: 0 0 1 0;
}

ServiceDetailScreen #service-detail-title-block {
    width: 1fr;
    height: 2;
}

ServiceDetailScreen #service-detail-title {
    height: 1;
    text-style: bold;
}

ServiceDetailScreen #service-detail-provider {
    height: 1;
    color: $text-muted;
}

ServiceDetailScreen #service-detail-state {
    width: 12;
    height: 2;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

ServiceDetailScreen #service-detail-state.status-ok { color: $success; }
ServiceDetailScreen #service-detail-state.status-idle { color: $text-muted; }
ServiceDetailScreen #service-detail-state.status-warn { color: $warning; }
ServiceDetailScreen #service-detail-state.status-error { color: $error; }
ServiceDetailScreen #service-detail-state.status-unknown { color: $text-muted; }

ServiceDetailScreen .service-detail-line {
    width: 100%;
    height: 1;
    color: $text;
    overflow: hidden;
}

ServiceDetailScreen .service-detail-error {
    color: $error;
}

/* ---------- Diagnostics ---------- */

DiagnosticsScreen {
    align: center middle;
    background: $background 75%;
}

DiagnosticsScreen #diagnostics-dialog {
    width: 62;
    height: 17;
    padding: 0 1;
    border: round $primary;
    background: $surface;
}

DiagnosticsScreen #diagnostics-header {
    width: 100%;
    height: 2;
    margin: 0 0 1 0;
}

DiagnosticsScreen #diagnostics-title {
    width: 1fr;
    height: 2;
    content-align: left middle;
    text-style: bold;
}

DiagnosticsScreen .diagnostics-row {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

DiagnosticsScreen .diagnostics-label {
    width: 12;
    color: $text-muted;
    text-style: bold;
}

DiagnosticsScreen .diagnostics-value {
    width: 1fr;
    overflow: hidden;
}

DiagnosticsScreen .diagnostics-row.ok .diagnostics-value { color: $success; }
DiagnosticsScreen .diagnostics-row.warn .diagnostics-value { color: $warning; }
DiagnosticsScreen .diagnostics-row.error .diagnostics-value { color: $error; }
DiagnosticsScreen .diagnostics-row.muted .diagnostics-value { color: $text-muted; }
